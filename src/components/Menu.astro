---
import MenuItem from "./MenuItem.astro";

const { pathname } = Astro.url;
---

<nav class="from-secondary sticky top-0 z-1 bg-linear-to-r to-amber-300">
  <div class="h-12 w-full">
    <div class="font-body flex h-full w-full justify-start">
      <MenuItem menuTitle="Home" menuIcon="mdi:home" href="/" />
      <MenuItem
        menuTitle="Bottle Clocks"
        menuIcon="mdi:bottle-wine"
        href="/bottle-clocks"
      />
      <MenuItem
        menuTitle="Contact Us"
        menuIcon="mdi:phone"
        href="/contact-us"
      />
    </div>
  </div>
</nav>
